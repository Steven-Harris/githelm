{
  "name": "githelm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build": "vite build",
    "serve": "vite preview",
    "postinstall": "pnpm svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --ext .js,.ts,.svelte .",
    "lint:fix": "eslint --ext .js,.ts,.svelte --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steven-Harris/githelm.git"
  },
  "author": "steven-harris",
  "bugs": {
    "url": "https://github.com/Steven-Harris/githelm/issues"
  },
  "homepage": "https://githelm.com",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@octokit/core": "^7.0.7",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@sentry/browser": "^10.70.0",
    "@sentry/svelte": "^10.70.0",
    "@sentry/sveltekit": "^10.70.0",
    "@sentry/vite-plugin": "^5.4.0",
    "firebase": "^12.17.1",
    "highlight.js": "^11.11.2",
    "marked": "^18.0.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/types": "^17.0.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.22.0",
    "firebase-tools": "^15.26.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "0.35.3",
    "sharp-ico": "0.1.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-preprocess": "^6.0.5",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "protobufjs",
      "re2",
      "sharp",
      "svelte-preprocess"
    ],
    "overrides": {
      "cookie": "^0.7.2"
    }
  }
}
